      <yloc>96</yloc>
    </GUI>
    <description>Trim and lower the product name</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Select values</name>
    <fields>
      <field>
        <name>uuid</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>user_uuid</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
