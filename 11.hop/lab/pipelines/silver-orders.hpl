        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>quantity</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>product</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>uuid</name>
        <rename>order_id</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type/>
        <conversion_mask/>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <encoding/>
        <roundingType>half_even</roundingType>
      </meta>
      <meta>
        <name>user_uuid</name>
        <rename>user_id</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type/>
        <conversion_mask/>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <encoding/>
        <roundingType>half_even</roundingType>
      </meta>
      <meta>
        <name>date_ms</name>
        <rename>ordered_at</rename>
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type/>
