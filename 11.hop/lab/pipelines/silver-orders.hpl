        <position>-1</position>
        <length>-1</length>
        <type>String</type>
        <ignore>N</ignore>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <repeat>N</repeat>
        <null_string/>
        <if_null_value/>
      </field>
      <field>
        <name>quantity</name>
        <position>-1</position>
        <length>-1</length>
        <type>String</type>
        <ignore>N</ignore>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <repeat>N</repeat>
