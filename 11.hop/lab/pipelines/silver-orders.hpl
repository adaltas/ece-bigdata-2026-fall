      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Filter rows</name>
    <compare>
      <condition>
        <negated>Y</negated>
        <operator>-</operator>
        <function>=</function>
        <value>
          <length>0</length>
          <precision>0</precision>
          <isnull>N</isnull>
        </value>
        <conditions>
          <condition>
            <negated>N</negated>
            <operator>-</operator>
            <leftvalue>known_user_id</leftvalue>
            <function>=</function>
            <value>
              <name>constant</name>
              <type>String</type>
              <text/>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
            <conditions/>
          </condition>
        </conditions>
      </condition>
    </compare>
    <send_true_to>Sort rows</send_true_to>
    <send_false_to>Text file output</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>896</xloc>
      <yloc>96</yloc>
    </GUI>
    <description>Not (known_user_id is empty): orders of an unknown user go to the quarantine</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type>
