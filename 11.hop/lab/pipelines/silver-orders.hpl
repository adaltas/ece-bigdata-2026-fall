    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>256</xloc>
      <yloc>96</yloc>
    </GUI>
    <description>Keep the milliseconds only: the Parquet output stores dates with a precision of 1 ms</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>StringOperations</type>
