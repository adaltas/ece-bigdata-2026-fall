    <length>Characters</length>
    <filters/>
    <error_count_field/>
    <error_fields_field/>
    <error_text_field/>
    <error_line_skipped>N</error_line_skipped>
    <schema_definition/>
    <ignore_fields>N</ignore_fields>
    <shortFileFieldName/>
    <extensionFieldName/>
    <pathFieldName/>
    <sizeFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
