    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>StreamLookup</type>
    <name>Stream lookup</name>
    <from>Parquet file input</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>N</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key>
        <name>user_id</name>
        <field>user_id</field>
      </key>
      <value>
