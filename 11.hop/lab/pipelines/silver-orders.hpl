      </parameter>
    </parameters>
    <name>silver-orders</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Bronze to silver, orders: typed, cleaned, deduplicated; orders of unknown users quarantined</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/10/30 14:00:00.000</created_date>
    <modified_date>2026/10/30 14:00:00.000</modified_date>
  </info>
  <transform>
    <type>TextFileInput2</type>
    <name>Text file input</name>
    <file_type>CSV</file_type>
    <compression>None</compression>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <enclosure_breaks>N</enclosure_breaks>
    <escapechar/>
    <null_if_not_enclosed>N</null_if_not_enclosed>
    <header>Y</header>
    <prependFileName>N</prependFileName>
    <nr_headerlines>1</nr_headerlines>
    <footer>N</footer>
