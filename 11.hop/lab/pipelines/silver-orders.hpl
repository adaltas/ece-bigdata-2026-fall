        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <repeat>N</repeat>
        <null_string/>
        <if_null_value/>
      </field>
      <field>
